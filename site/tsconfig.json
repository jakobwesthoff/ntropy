{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client", "bun"],
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "build.ts",
    "vite.config.ts",
    "../tests/fixtures/query-corpus.json"
  ]
}
