// This Source Code Form is subject to the terms of the Mozilla Public
// License, v. 2.0. If a copy of the MPL was not distributed with this
// file, You can obtain one at https://mozilla.org/MPL/2.0/.

// Engine-owned definitions inlined ahead of every emitted document. They are
// the seam a theme replaces: a theme is a different prelude defining `note`,
// `callout`, `notelink`, and `task`, while the converted body below stays
// identical. Inlining (rather than importing) keeps the emitted `typst`
// artifact a single self-contained file that compiles next to the note.
//
// The default theme names only the fonts the typst binary bundles (Libertinus
// Serif, New Computer Modern, DejaVu Sans Mono). Libertinus Serif covers
// Latin, Greek, Cyrillic and Hebrew. A script it does not cover, such as
// Arabic or Japanese, is drawn from a font on the machine when there is one,
// so the note looks different from machine to machine. Without one, typst
// falls back to DejaVu Sans Mono for Arabic and draws Japanese as empty boxes.

// Render a frontmatter value as legible inline text. Strings pass through as
// themselves; arrays and dictionaries recurse so nested metadata stays
// readable rather than collapsing to a Typst repr; every other scalar (int,
// float, bool, none, datetime) falls back to its repr, which is faithful and
// short for leaf values.
#let fmt-value(value) = {
  if type(value) == str {
    value
  } else if type(value) == array {
    value.map(fmt-value).join(", ")
  } else if type(value) == dictionary {
    value.pairs().map(((k, v)) => k + ": " + fmt-value(v)).join("; ")
  } else {
    repr(value)
  }
}

// A value that carries nothing worth displaying. The template still receives
// such fields; skipping them is purely a presentation choice of this theme.
#let is-empty(value) = {
  value == none or value == "" or value == () or value == (:)
}

// Per-kind callout identity. The palette follows the GitHub admonition
// colors, so notes rendered here read like they do on github.com.
#let callout-styles = (
  note: (color: rgb("#0969da"), label: "Note"),
  tip: (color: rgb("#1a7f37"), label: "Tip"),
  important: (color: rgb("#8250df"), label: "Important"),
  warning: (color: rgb("#9a6700"), label: "Warning"),
  caution: (color: rgb("#cf222e"), label: "Caution"),
)

// A callout is a GFM admonition: a colored left bar, a tinted fill, and a
// colored bold lead-in. The emitter calls it for the five GFM kinds only, as
// another marker stays a quote. A kind outside the table, such as one a theme
// passes itself, takes the same form in neutral grey with its own capitalized
// name as the lead-in.
#let callout(kind: "note", body) = {
  let style = callout-styles.at(
    kind,
    default: (color: luma(90), label: upper(kind.slice(0, 1)) + kind.slice(1)),
  )
  block(
    width: 100%,
    stroke: (left: 3pt + style.color),
    fill: style.color.lighten(94%),
    radius: (right: 4pt),
    inset: (left: 1em, rest: 0.7em),
    {
      text(weight: "bold", fill: style.color, style.label)
      linebreak()
      body
    },
  )
}

// A resolved note-to-note link: the target's current title, set apart from
// ordinary emphasis by the link color.
#let notelink(body) = {
  text(fill: rgb("#0969da"), emph(body))
}

// A task-list checkbox, drawn rather than taken from a glyph: one identical
// box for both states, so checked and unchecked always match optically. The
// tick is a stroked path, as none of the bundled text fonts has a check mark
// glyph and typst would take one from a font on the machine.
#let task(done: false) = {
  box(
    width: 0.85em,
    height: 0.85em,
    stroke: 0.7pt + luma(110),
    radius: 1.5pt,
    baseline: 0.1em,
    if done {
      place(curve(
        stroke: (paint: luma(40), thickness: 0.09em, cap: "round", join: "round"),
        curve.move((0.2em, 0.45em)),
        curve.line((0.37em, 0.63em)),
        curve.line((0.66em, 0.22em)),
      ))
    },
  )
  h(0.4em)
}

// The document template. It receives the note title, the complete frontmatter
// mapping, and the paper size, and lays them out as the default look: the
// title prominent and centered, a subdued metadata line (tags as chips, other
// fields as quiet key-value pairs, empty values skipped), a separating rule,
// then the converted body.
#let note(title: none, frontmatter: (:), paper: "a4", body) = {
  // A conditional set rule: a `set` inside an `if` block would be scoped to
  // that block and never reach the document. The guard also avoids
  // `set document(title: none)`, which would be a type error.
  set document(title: title) if title != none

  set page(paper: paper, margin: (x: 2.2cm, y: 2.4cm))
  set text(size: 11pt)
  set par(justify: true, leading: 0.7em)

  // Heading rhythm: air above, tight below, restrained size steps.
  show heading: set block(above: 1.6em, below: 0.8em)
  show heading.where(level: 1): set text(size: 1.45em)
  show heading.where(level: 2): set text(size: 1.2em)
  show heading.where(level: 3): set text(size: 1.05em)

  // Inline code as a subtle chip; block code as a filled panel.
  show raw.where(block: false): it => box(
    fill: luma(245),
    stroke: 0.4pt + luma(225),
    radius: 2pt,
    inset: (x: 3pt, y: 0pt),
    outset: (y: 3pt),
    it,
  )
  show raw.where(block: true): it => block(
    width: 100%,
    fill: luma(248),
    stroke: 0.4pt + luma(230),
    radius: 4pt,
    inset: 10pt,
    text(size: 0.9em, it),
  )

  // Quotes: quiet grey rule, softened text, no fill.
  show quote.where(block: true): it => block(
    stroke: (left: 2.5pt + luma(210)),
    inset: (left: 1em, y: 0.3em),
    text(fill: luma(60), it.body),
  )

  // Tables: horizontal rules only, bold header row, centered on the page
  // while keeping their content width.
  set table(
    stroke: (x, y) => if y == 0 {
      (bottom: 0.8pt + luma(120))
    } else {
      (bottom: 0.4pt + luma(210))
    },
    inset: 0.6364em,
  )
  show table.cell.where(y: 0): set text(weight: "bold")
  // A column without a Markdown alignment reaches typst as `auto`, which takes
  // the alignment around the table. The table block is centered below, so
  // without this rule those cells would be centered too. A column with an
  // alignment keeps its own.
  show table.cell: set align(start)
  // Typst sizes an automatic column from the text it measures, and a bold
  // header or a code chip is drawn wider than what was measured, so cells run
  // into each other in a table that is nearly as wide as the page. The rule
  // measures every column itself and builds the table with those widths: the
  // widest line of each column when all of them fit, otherwise the widest
  // word plus the cell padding as the least and the free width shared out in
  // proportion to what each column still wants. When even the least widths do
  // not fit, the table is set in smaller text, which scales the padding too
  // (it is in `em`). The size never drops below 60 percent, as text any
  // smaller is unreadable. A table that does not fit at that size is recorded
  // under the label `ntropy-table-too-wide`, which the engine queries to
  // warn. The result is still a table, so it breaks across pages and repeats
  // its header.
  show table: it => layout(size => {
    let floor = 0.6
    let columns = it.columns.len()
    // The table built below has fixed widths and comes through this rule
    // again.
    if columns == 0 or not it.columns.any(width => width == auto) {
      return align(center, it)
    }

    // The horizontal padding of one cell. A function-valued inset cannot be
    // read, so the prelude's own padding stands in for it.
    let to-length(value) = if type(value) == relative {
      value.length.to-absolute()
    } else if type(value) == length {
      value.to-absolute()
    } else {
      0pt
    }
    let padding = if type(it.inset) == dictionary {
      to-length(it.inset.at("left", default: it.inset.at("rest", default: 0pt)))
        + to-length(it.inset.at("right", default: it.inset.at("rest", default: 0pt)))
    } else if type(it.inset) == function {
      2 * 0.6364em.to-absolute()
    } else {
      2 * to-length(it.inset)
    }

    // The content of a cell as fragments, with `none` where a line may break.
    // A word of the cell is a run of fragments between two breaks, which
    // typst keeps in several elements when it holds an escaped hyphen, so the
    // fragments are joined again before they are measured. Each fragment is
    // wrapped in the element it is drawn in (the code chip, bold), so it is
    // measured through the same rules.
    let pieces(content, wrap) = if type(content) == str {
      let parts = content.split(regex("\\s+"))
      parts.enumerate().map(((index, part)) => {
        let fragment = if part == "" { () } else { (wrap(part),) }
        if index > 0 { (none,) + fragment } else { fragment }
      }).flatten()
    } else if content.func() == raw {
      pieces(content.text, word => wrap(raw(word)))
    } else if content.func() == text {
      pieces(content.text, wrap)
    } else if content.func() == [ ].func() or content.func() == linebreak {
      (none,)
    } else if content.func() == strong {
      pieces(content.body, word => wrap(strong(word)))
    } else if content.func() == emph {
      pieces(content.body, word => wrap(emph(word)))
    } else if content.func() == footnote or content.func() == smartquote {
      (wrap(content),)
    } else if content.has("text") {
      // A symbol, such as the straight quote or `@` the emitter escapes. It
      // carries its character in `text` but is not a `text` element.
      (wrap(content),)
    } else if content.has("child") {
      // A `styled` element, such as the `text(fill: ..)` a note link wraps its
      // body in, draws its child with the styles applied.
      pieces(content.child, wrap)
    } else if content.has("body") {
      pieces(content.body, wrap)
    } else if content.has("children") {
      content.children.map(child => pieces(child, wrap)).flatten()
    } else {
      ()
    }
    let words(content) = {
      let found = ()
      let current = ()
      for fragment in pieces(content, word => word) {
        if fragment == none {
          if current.len() > 0 {
            found.push(current.join())
            current = ()
          }
        } else {
          current.push(fragment)
        }
      }
      if current.len() > 0 {
        found.push(current.join())
      }
      found
    }

    // Per column: the least width (widest word) and the most (widest cell on
    // one line), both with the padding.
    let least = (0pt,) * columns
    let most = (0pt,) * columns
    let cells = it.children
      .map(child => if child.func() == table.header { child.children } else { (child,) })
      .flatten()
    for (index, cell) in cells.enumerate() {
      let column = calc.rem(index, columns)
      let body = if cell.func() == table.cell { cell.body } else { cell }
      let weight = if index < columns { "bold" } else { "regular" }
      for word in words(body) {
        least.at(column) = calc.max(least.at(column), measure(text(weight: weight, word)).width + padding)
      }
      most.at(column) = calc.max(most.at(column), measure(text(weight: weight, body)).width + padding)
    }

    let least-total = least.sum()
    let most-total = most.sum()
    let ratio = 1.0
    if least-total > size.width {
      ratio = calc.max(size.width / least-total, floor)
      if size.width / least-total < floor {
        [#metadata((columns: columns, scale: size.width / least-total))<ntropy-table-too-wide>]
      }
    }

    // Widths scale with the text size, and the width left over goes to the
    // columns in proportion to how much wider than their least they want to be.
    let widths = if most-total * ratio <= size.width {
      most.map(width => width * ratio)
    } else {
      let spare = calc.max(size.width - least-total * ratio, 0pt)
      let wanted = most-total - least-total
      least.zip(most).map(((low, high)) => {
        low * ratio + if wanted > 0pt { spare * ((high - low) / wanted) } else { 0pt }
      })
    }

    // The columns are as wide as their widest word, so a word that only fits
    // after typst hyphenated it would be a word the measuring never saw. A
    // word still breaks at a space or at a hyphen it contains.
    set text(size: ratio * 1em, hyphenate: false)
    align(center, table(columns: widths, align: it.align, ..it.children))
  })

  // Links in classic muted blue; thematic breaks in light grey.
  show link: set text(fill: rgb("#0969da"))
  set line(stroke: 0.6pt + luma(190))

  if title != none {
    align(center, text(size: 1.7em, weight: "bold", title))
    v(0.3em)
  }

  let fields = frontmatter
    .pairs()
    .filter(((key, value)) => key != "title" and not is-empty(value))
  if fields.len() > 0 {
    align(
      center,
      {
        set text(size: 0.85em, fill: luma(90))
        // Tags render as chips; other fields as quiet key-value pairs.
        let parts = ()
        for (key, value) in fields {
          if key == "tags" and type(value) == array {
            parts.push(
              value
                .map(tag => box(
                  fill: luma(240),
                  radius: 6pt,
                  inset: (x: 6pt, y: 2pt),
                  text(size: 0.95em, tag),
                ))
                .join(h(0.4em)),
            )
          } else {
            parts.push([#text(weight: "semibold", key + ":") #fmt-value(value)])
          }
        }
        parts.join(h(1.2em))
      },
    )
  }
  v(0.6em)
  line(length: 100%, stroke: 0.6pt + luma(200))
  v(0.9em)

  body
}

#show: note.with(title: "Kitchen Sink", frontmatter: ("title": "Kitchen Sink", "tags": ("area/work", "demo"), "priority": 2, "ratio": 1.5, "draft": false, "reviewer": none, "review": ("due": "[DATE....]", "by": "jakob"), "aliases": (), "angle": "!degrees 90"), paper: "a4",)

